    "dev": "python3 scripts/serve.py",
    "test:models": "node tests/browser-models.mjs",
    "verify:models": "node scripts/verify-models.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0"
}
